{
  "name": "AIStudyLog",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "answer": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "question",
    "answer"
  ]
}